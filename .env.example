# The engine needs NO variables to start. Both below are optional.

# Link the engine's "Audit an invoice" buttons point to (the n8n form). Default:
# https://n8n-j3bs-app.alternatefutures.ai/form/audit
FORM_URL=

# Pin "today" so the dispute-window badge is stable in demos, e.g. 2026-10-10
DEMO_AS_OF_DATE=

# n8n service variables (set in the Alternate Clouds dashboard, never in git):
# N8N_ENCRYPTION_KEY=<32 random characters, set once, never change>
# WEBHOOK_URL=https://<your-n8n-service>-app.alternatefutures.ai
# The Groq API key goes into an n8n credential named "Groq account", not here.
