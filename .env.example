# The engine needs NO variables to start. Everything below is optional.

# Engine (optional): pin "today" so the dispute-window badge is stable in demos, e.g. 2026-10-10
DEMO_AS_OF_DATE=

# n8n service (set these in the Alternate Clouds Variables tab of the n8n service, never in git)
N8N_ENCRYPTION_KEY=<32-char random string, set once, never change>
WEBHOOK_URL=https://<your-n8n-service-name>-app.alternatefutures.ai
# Groq API key goes into an n8n credential (Credentials > Groq), NOT here.
